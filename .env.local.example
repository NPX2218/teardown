# Server key. Voice mints an ephemeral token with it. The text guide sends it to chat completions.
# Copy this file to .env.local. A file named .env.example is gitignored by the .env* rule.
XAI_API_KEY=
# Chat model for the text guide (askAgent / POST /api/agent).
XAI_TEXT_MODEL=
# Imagine model. Voice and the tour / level tools do not read it.
XAI_IMAGE_MODEL=
# Optional TTS voice id. Defaults to eve. The live Voice socket also defaults to eve.
XAI_VOICE=
