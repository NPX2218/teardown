# Server key. Voice mints an ephemeral token with it. The text guide and Imagine send it upstream.
# Copy this file to .env.local. A file named .env.example is gitignored by the .env* rule.
# The browser never sees this value.
XAI_API_KEY=
# Chat model for the text guide (askAgent / POST /api/agent).
XAI_TEXT_MODEL=
# Imagine model. The current docs id is grok-imagine-image-2.0. Voice and the tour / level tools do not read it.
XAI_IMAGE_MODEL=
# Optional TTS voice id. Defaults to eve. The live Voice socket also defaults to eve.
XAI_VOICE=
